FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-runtime.lock ./
RUN pip install --no-cache-dir -r requirements-runtime.lock && useradd -u 10001 -m openfeed
COPY openfeed/ ./openfeed/
COPY static/ ./static/
COPY ops/ ./ops/
USER 10001:10001
ENTRYPOINT ["python", "ops/run_cycle.py"]
